# Copy this to .env in the same folder as docker-compose.yml before running
# `docker compose up --build`. These values are passed through to the
# backend and frontend containers.

CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_APP_NAME=EcoAlert

# Required — MongoDB is not reachable without these. No default password is provided
# deliberately; docker compose will fail to authenticate (not silently run insecurely)
# if you forget to set MONGO_ROOT_PASSWORD.
# Generate a password with: openssl rand -hex 24
MONGO_ROOT_USERNAME=ecoalert_admin
MONGO_ROOT_PASSWORD=

# Generate with: openssl rand -hex 32  (must be at least 32 characters)
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=15m
# Generate with: openssl rand -hex 32  (must be different from JWT_SECRET, min 32 chars)
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_32
JWT_REFRESH_EXPIRES_IN=30d

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="EcoAlert <no-reply@ecoalert.app>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
