# Copy this to .env in the same folder as docker-compose.yml before running
# `docker compose up --build`. These values are passed through to the
# backend and frontend containers.

CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_APP_NAME=EcoAlert

# Supabase — create a project at https://supabase.com/dashboard, then fill these
# in from Project Settings → API (URL, anon key, service_role key) and
# Project Settings → Database → Connection string → URI (use the "Session
# pooler" string, not "Direct connection" — direct connections are IPv6-only
# on new projects and won't resolve from most networks/CI runners).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="EcoAlert <no-reply@ecoalert.app>"

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
