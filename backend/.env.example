# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
# Local MongoDB (no auth):
#   MONGODB_URI=mongodb://localhost:27017/ecoalert
# MongoDB Atlas (get this from Atlas → Database → Connect → Drivers):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/ecoalert?retryWrites=true&w=majority&appName=<your-app-name>
# Include a database name in the path (e.g. "/ecoalert") — Atlas's own connection-string
# generator omits it by default, which would silently fall back to a database named "test".
# Whitelist your IP under Atlas → Network Access, or 0.0.0.0/0 for unrestricted dev access.
MONGODB_URI=mongodb://localhost:27017/ecoalert

# Auth
# Generate with: openssl rand -hex 32  (must be at least 32 characters)
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=15m
# Generate with: openssl rand -hex 32  (must be different from JWT_SECRET, min 32 chars)
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_32
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="EcoAlert <no-reply@ecoalert.app>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# Only used by `npm run seed:admin` (one-time, creates the first admin account) —
# not read by the running server, safe to leave unset otherwise.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
