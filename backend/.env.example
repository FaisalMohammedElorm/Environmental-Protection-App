# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS), e.g.:
#   CLIENT_URL=http://localhost:3000,https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# Supabase
# Create a project at https://supabase.com/dashboard, then fill these in.
# URL / anon key / service_role key: Project Settings -> API
# JWT verification uses Supabase's JWKS endpoint (derived from SUPABASE_URL
# below), not a shared secret — nothing else to configure for that.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Full admin access — bypasses Row Level Security. Server-side only, never
# send this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Postgres connection string — Project Settings -> Database -> Connection
# string -> URI. Use the "Session pooler" string (port 5432), not "Direct
# connection": new Supabase projects' direct-connection hostnames are
# IPv6-only and won't resolve on most networks/CI runners.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ -> %40, ! -> %21, etc).
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# Email (SMTP) — only used for the contact form (services/email.service.ts).
# Auth emails (verification, password reset) are sent by Supabase Auth
# itself; configure those under Supabase Dashboard -> Authentication -> Emails.
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM="EcoAlert <no-reply@ecoalert.app>"

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# Only used by `npm run seed:admin` (one-time, creates the first admin account) —
# not read by the running server, safe to leave unset otherwise.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
