# Public API base URL consumed by the browser
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Supabase — same project as the backend. Project Settings -> API -> URL /
# anon public key. Safe to expose to the browser: the anon key only grants
# whatever access the database's Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Map provider key (OpenStreetMap/Leaflet does not require one; set if using Google Maps)
NEXT_PUBLIC_MAP_API_KEY=your_map_api_key_here

# Branding
NEXT_PUBLIC_APP_NAME=EcoAlert
