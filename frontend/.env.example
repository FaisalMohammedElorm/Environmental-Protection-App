# Supabase — Project Settings -> API -> URL / anon public key. Safe to
# expose to the browser: the anon key only grants whatever access the
# database's Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Map provider key (OpenStreetMap/Leaflet does not require one; set if using Google Maps)
NEXT_PUBLIC_MAP_API_KEY=your_map_api_key_here

# Branding
NEXT_PUBLIC_APP_NAME=EcoAlert

# Server-only (never NEXT_PUBLIC_ — used only inside Server Actions in
# src/app/actions/, never sent to the browser).
# Project Settings -> API -> service_role key. Full admin access, bypasses
# RLS — used for report-image Storage uploads/signed URLs.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Email (SMTP) — server-only, used by the contact-form Server Action. Only
# powers the contact form; auth emails are sent by Supabase Auth itself.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="EcoAlert <no-reply@ecoalert.app>"
