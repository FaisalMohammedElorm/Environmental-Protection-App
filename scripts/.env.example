# Supabase — Project Settings → Database → Connection string → URI (use the
# "Session pooler" string, not "Direct connection" — direct connections are
# IPv6-only on new projects and won't resolve from most networks/CI runners).
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Only used by `npm run seed:admin`
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
